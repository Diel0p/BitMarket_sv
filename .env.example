# BitMarket SV — Environment Configuration
# Based on: bitmarket-py-reference

# ── Server ────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# -- Database (PostgreSQL) --------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bitmarket

# -- Bootstrap superuser (optional, used by app/bootstrap_db.py) --
SUPERUSER_NAME=Super Admin
SUPERUSER_EMAIL=admin@bitmarket.sv
SUPERUSER_PASSWORD=Admin1234!

# ── Auth ──────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── LNbits ────────────────────────────────────────────────
# Platform main wallet (receives buyer payments and redistributes payouts)
LNBITS_URL=http://13.59.253.146:5000
LNBITS_ADMIN_KEY=3d0433a4f9bf4d9cadcbf3a22b5c74aa

# Platform commission destination (LNbits LNURLp link)
# Replace REEMPLAZAR_CON_TOKEN_REAL with your real LNbits wallet token
PLATFORM_COMMISSION_LIGHTNING_ADDRESS=http://13.59.253.146:5000/lnurlp/link/REEMPLAZAR_CON_TOKEN_REAL

# Mock payments
MOCK_CONFIRM_SECONDS=10
INVOICE_EXPIRE_SECONDS=600

# Platform fee (%)
MARKETPLACE_FEE_PERCENT=5
