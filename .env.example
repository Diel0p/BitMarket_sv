# ==============================================================================
# BitMarket SV — Plantilla de Configuración de Variables de Entorno (.env.example)
# ==============================================================================
# Copie este archivo como '.env' en la raíz de su proyecto y configure los valores.
# Ejemplo en Linux/macOS: cp .env.example .env
# Ejemplo en Windows PowerShell: Copy-Item .env.example .env
# Ejemplo en Windows CMD: copy .env.example .env
# ==============================================================================

# ── 1. CONFIGURACIÓN DEL SERVIDOR ─────────────────────────────────────────────
# Nombre de la aplicación (se muestra en el encabezado y correos)
APP_NAME="BitMarket SV"

# Versión actual de la aplicación
APP_VERSION=1.0.0

# Host donde correrá el servidor local (0.0.0.0 expone en la red local; usar localhost para solo local)
APP_HOST=0.0.0.0

# Puerto de escucha del servidor FastAPI
APP_PORT=8000

# Activar/desactivar modo depuración (muestra errores detallados en pantalla y recarga automática)
DEBUG=true

# ── 2. BASE DE DATOS (POSTGRESQL) ─────────────────────────────────────────────
# Dirección de conexión a PostgreSQL (JSONB document store).
# Estructura: postgresql://[usuario]:[contraseña]@[host]:[puerto]/[nombre_base_de_datos]
# IMPORTANTE: Asegúrese de haber creado primero la base de datos con: CREATE DATABASE bitmarket;
# NOTA: Reemplace 'TU_CONTRASEÑA_AQUÍ' por su contraseña real de PostgreSQL.
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA_AQUÍ@localhost:5432/bitmarket

# ── 3. SUPERUSUARIO / ADMINISTRADOR (BOOTSTRAP) ───────────────────────────────
# Credenciales iniciales para el primer inicio del sistema (creadas mediante python app/bootstrap_db.py)
SUPERUSER_NAME="Super Admin"
SUPERUSER_EMAIL=admin@bitmarket.sv
SUPERUSER_PASSWORD=Admin1234!

# ── 4. AUTENTICACIÓN Y SEGURIDAD ──────────────────────────────────────────────
# Clave secreta para firmar tokens JWT. ¡CAMBIAR EN PRODUCCIÓN por un valor aleatorio seguro!
# Generar una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production-please

# Algoritmo de encriptación utilizado para la firma JWT (HS256 es el estándar)
ALGORITHM=HS256

# Duración del token de sesión activa del usuario (en minutos).
# 120 minutos equivalen a 2 horas (configuración activa del sistema real).
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ── 5. PASARELA DE PAGOS LIGHTNING (LNBITS) ───────────────────────────────────
# Si deja en blanco estas variables, el sistema activará automáticamente el MODO MOCK (simulación).
# En MODO MOCK no se requiere dinero real y el pago se confirma tras unos segundos.

# URL de la API de su nodo o billetera LNbits (Ejemplo local / de desarrollo):
LNBITS_URL=http://13.59.253.146:5000
# Configuración del nodo real:
#LNBITS_URL=https://lnbits.daxsosa.com

# Clave de administración de la billetera LNbits (Admin Key):
LNBITS_ADMIN_KEY=3d0433a4f9bf4d9cadcbf3a22b5c74aa
# Configuración del nodo real:
#LNBITS_ADMIN_KEY=050c5f69e7a14e4a9710e9a3b5c7ec1a

# Dirección Lightning o link de LNurlp para recibir la comisión de la plataforma.
# Reemplazar REEMPLAZAR_CON_TOKEN_REAL con el token de su enlace de LNbits.
PLATFORM_COMMISSION_LIGHTNING_ADDRESS=http://13.59.253.146:5000/lnurlp/link/REEMPLAZAR_CON_TOKEN_REAL

# ── 6. CONTROL Y TIEMPOS DE PAGOS ─────────────────────────────────────────────
# Tiempo (en segundos) en el que se confirma automáticamente un pago ficticio en Modo Mock
MOCK_CONFIRM_SECONDS=10

# Tiempo de vida de una factura Lightning (en segundos) antes de expirar (300s = 5 minutos)
INVOICE_EXPIRE_SECONDS=300

# Porcentaje de comisión que se cobra por cada venta realizada en el mercado
MARKETPLACE_FEE_PERCENT=3

# ── 7. CONFIGURACIÓN DE CORS (COMPARTICIÓN DE RECURSOS) ───────────────────────
# Orígenes web permitidos para conectarse a la API (separados por comas)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
