# BitMarket SV — Environment Variables
# Copy: cp .env.example .env
# The app runs with ALL defaults — .env is optional for demo.

# ── Server ────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── Auth ──────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── LNbits (optional) ─────────────────────────────────────
# Leave blank → mock mode (invoices auto-confirm after 10 seconds)
# Set both → live Lightning payments using the platform/super-admin wallet
# This wallet receives the buyer payment first, then the app pays sellers their net amount.
LNBITS_URL=
LNBITS_ADMIN_KEY=

# Platform Lightning address to receive commissions (LNURLp or Lightning Address)
# Example: http://YOUR_SERVER:5000/lnurlp/link/TOKEN or admin@yourdomain.com
PLATFORM_COMMISSION_LIGHTNING_ADDRESS=

# Seconds until mock invoice auto-confirms (demo)
MOCK_CONFIRM_SECONDS=10

# Seconds until invoice expires
INVOICE_EXPIRE_SECONDS=600

# Marketplace fee retained by the platform wallet
MARKETPLACE_FEE_PERCENT=5.0
